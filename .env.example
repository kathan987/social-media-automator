# Copy to .env and fill in. Never commit .env or paste keys into chat. Details: docs/setup.md section 2.

# ElevenLabs voice with word timings (optional: tools/vo_edge.py is free). Paid plan before you monetize.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini (aistudio.google.com/apikey): the dashboard's draft, scoring, clip indexing and trends.
GEMINI_API_KEY=

# Pixabay (optional): free stock clips and photos for comparisons.
PIXABAY_API_KEY=

# Optional: a Gemini model to try first, and a trends page for your niche (dashboard/research.py viral)
GEMINI_MODEL=
VIRAL_PAGE=

# Firecrawl is NOT read from here: set FIRECRAWL_API_KEY in the terminal you start Claude Code from (.mcp.json uses it).
# Higgsfield connects through Claude's connector settings, not a key here.
